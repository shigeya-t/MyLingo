#!/bin/sh
# Writes the checked-out commit to extension/lib/version.js so the web app and
# the extension can show which version is running. The file is gitignored.
root=$(git rev-parse --show-toplevel) || exit 0
hash=$(git rev-parse --short HEAD 2>/dev/null) || exit 0
printf "globalThis.MYLINGO_COMMIT = '%s';\n" "$hash" > "$root/extension/lib/version.js"
